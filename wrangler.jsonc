{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "contextgateway-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "contextgateway",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "FREE_RATE_LIMITER",
      "namespace_id": "61001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    },
    {
      "name": "PAID_RATE_LIMITER",
      "namespace_id": "61002",
      "simple": {
        "limit": 1000,
        "period": 60
      }
    }
  ]
}

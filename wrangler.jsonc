{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "contextgateway-edge",
  "main": "src/entrypoint.ts",
  "compatibility_date": "2026-08-27",
  "routes": [
    {
      "pattern": "contextgateway.sharecapsule.org",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "CONTROL_PLANE_TOKEN",
      "UPSTREAM_ENCRYPTION_KEY",
      "BETTER_AUTH_SECRET",
      "CAPABILITY_SIGNING_KEY"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/healthz"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "17 8 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcp-context",
      "database_id": "139c3fd4-bbcb-41b6-868c-0fa6f589ab02",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "FREE_RATE_LIMITER",
      "namespace_id": "61001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    },
    {
      "name": "PAID_RATE_LIMITER",
      "namespace_id": "61002",
      "simple": {
        "limit": 1000,
        "period": 60
      }
    }
  ]
}
